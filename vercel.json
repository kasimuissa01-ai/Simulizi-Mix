{
  "rewrites": [
    {
      "source": "/((?!manifest.json|sw.js|icon-192.png|icon-512.png|icon-192-maskable.png|icon-512-maskable.png|apple-touch-icon.png|logo.png|assets/.*|onesignal/.*|api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/daily-notification",
      "schedule": "0 17 * * *"
    }
  ]
}
